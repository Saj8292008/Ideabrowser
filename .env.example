# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: named Firestore database (AI Studio provisions one); omit for "(default)"
VITE_FIRESTORE_DATABASE_ID=
# Optional, local testing only: point at the Firestore emulator
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
